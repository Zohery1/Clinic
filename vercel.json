{
  "framework": null,
  "buildCommand": "bash build.sh",
  "outputDirectory": "build/web",
  "headers": [
    {
      "source": "/(.*).(js|css|wasm|png|jpg|jpeg|gif|svg|ico|otf|ttf|woff|woff2|json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/evo/:path*",
      "destination": "http://37.27.31.127:8081/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!admin|api/evo).*)",
      "destination": "/index.html"
    }
  ]
}
