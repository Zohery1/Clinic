{
  "headers": [
    {
      "source": "/(.*)\\.(js|wasm|css|json|png|jpg|jpeg|gif|ico|svg|ttf|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(index.html|flutter_bootstrap.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/evo/:path*",
      "destination": "http://37.27.31.127:8081/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!admin|api/evo).*)",
      "destination": "/index.html"
    }
  ]
}

