{
  "name": "Clinic WhatsApp Automation",
  "nodes": [
    {
      "parameters": {
        "path": "send-whatsapp",
        "responseMode": "lastNode",
        "options": {
          "rawBody": false
        }
      },
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "send-whatsapp"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://evolution_api:8080/message/sendText/' + $json.body.instanceName }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.body.phone, text: $json.body.message }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "2",
      "name": "Evolution API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "EvoAPI Key"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Evolution API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {},
  "tags": [
    {
      "name": "whatsapp"
    }
  ]
}
